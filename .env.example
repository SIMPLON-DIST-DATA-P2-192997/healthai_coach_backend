# --- PostgreSQL ---
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=healthai_coach
POSTGRES_USER=healthai
POSTGRES_PASSWORD=changeme
DATABASE_URL=postgresql://healthai:changeme@postgres:5432/healthai_coach
# À passer à "false" une fois que le vrai pipeline ETL (Airflow) alimente la
# base avec de vraies données — sinon db-init les efface à chaque
# `docker compose up` (cf. docs/guide_deploiement.md, "Point de vigilance").
SEED_DEMO_DATA=true

# --- Airflow ---
AIRFLOW__CORE__EXECUTOR=LocalExecutor
AIRFLOW__DATABASE__SQL_ALCHEMY_CONN=postgresql+psycopg2://healthai:changeme@postgres:5432/airflow
AIRFLOW__CORE__FERNET_KEY=
AIRFLOW_UID=50000
AIRFLOW_PORT=8080
# Compte admin créé au premier démarrage (service airflow-init) — à changer
# avant tout déploiement au-delà d'une démo locale.
_AIRFLOW_WWW_USER_USERNAME=airflow
_AIRFLOW_WWW_USER_PASSWORD=airflow

# --- API (FastAPI) ---
API_HOST=0.0.0.0
API_PORT=8000
JWT_SECRET_KEY=changeme
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60

# --- Sources externes ---
EXERCISEDB_API_URL=
EXERCISEDB_API_KEY=

# --- Metabase ---
METABASE_DB_HOST=postgres
METABASE_DB_PORT=5432
METABASE_DB_NAME=metabase
METABASE_DB_USER=healthai
METABASE_DB_PASSWORD=changeme
METABASE_PORT=3000

# --- Admin interface (Gradio) ---
ADMIN_INTERFACE_PORT=7860
